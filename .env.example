# ---------------------------------------------------------------------------
# AniNusa environment configuration
# Copy to .env for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public site URL used for canonical URLs, sitemap, OpenGraph and auth origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only canonical origin (recommended in production; overrides NEXT_PUBLIC_SITE_URL at runtime).
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=AniNusa

# PostgreSQL (required)
DATABASE_URL=postgresql://aninusa:aninusa@localhost:5432/aninusa?schema=public

# Redis (optional locally; strongly recommended in production)
# When omitted, an in-process LRU-ish cache and rate limiter are used.
REDIS_URL=redis://localhost:6379

# Sessions
# Generate with: openssl rand -base64 48
AUTH_SECRET=dev-only-change-me-dev-only-change-me-dev-only
SESSION_COOKIE_NAME=aninusa_session
SESSION_TTL_DAYS=7
# Set to false only for local production-mode smoke tests over plain HTTP.
COOKIE_SECURE=true

# Seed admin account (used by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@aninusa.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!

# Seed optional AniList metadata (official public GraphQL API, no scraping).
# Set to false to seed only the bundled open-media catalog.
SEED_ANILIST=true

# Authorized content providers
OPEN_MEDIA_ENABLED=true
ANILIST_ENABLED=true
ANILIST_RATE_LIMIT_PER_MINUTE=80
INGEST_MAX_EPISODES=60
INGEST_REQUEST_TIMEOUT_MS=15000

# Background workers
SOURCE_HEALTH_INTERVAL_MINUTES=15
SYNC_INTERVAL_MINUTES=360
HEALTH_CHECK_TIMEOUT_MS=10000
# Consecutive failures before a source is hidden from playback.
HEALTH_BROKEN_THRESHOLD=3
HEALTH_CHECK_USER_AGENT=AniNusaSourceHealth/1.0 (+https://example.com/source-health)

# Subtitle proxy: only hosts in this comma-separated allowlist may be fetched
# server-side. Local /public subtitle paths are always allowed.
SUBTITLE_HOST_ALLOWLIST=

# Public API rate limiting (requests per window)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PROGRESS_PER_MINUTE=120

# Logging: debug | info | warn | error
LOG_LEVEL=info



