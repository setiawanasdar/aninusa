{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@aninusa/types": ["packages/types/src/index.ts"],
      "@aninusa/utils": ["packages/utils/src/index.ts"],
      "@aninusa/database": ["packages/database/src/index.ts"],
      "@aninusa/source-adapters": ["packages/source-adapters/src/index.ts"],
      "@aninusa/services": ["packages/services/src/index.ts"],
      "@aninusa/player": ["packages/player/src/index.ts"]
    }
  }
}
